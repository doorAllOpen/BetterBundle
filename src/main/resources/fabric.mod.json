{
    "schemaVersion": 1,
    "id": "better-bundle",
    "version": "${version}",
    "name": "Better Bundle",
    "description": "Grouped bundle side panel, auto-deposit and matching rules for bundles",
    "authors": [
        "zeroowo24",
        "doorAllOpen"
    ],
    "contact": {
        "homepage": "https://github.com/doorAllOpen/BetterBundle",
        "sources": "https://github.com/doorAllOpen/BetterBundle"
    },
    "license": "CC0-1.0",
    "environment": "client",
    "entrypoints": {
        "client": [
            "betterbundle.BetterBundleMod"
        ],
        "modmenu": [
            "betterbundle.ModMenuIntegration"
        ]
    },
    "accessWidener": "better-bundle.accesswidener",
    "mixins": [
        {
            "config": "better-bundle.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.0",
        "minecraft": ">=26.3 <26.4",
        "fabric-api": "*",
        "java": ">=25"
    },
    "suggests": {
        "modmenu": "*"
    }
}
